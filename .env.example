# OmniTools — Production Environment Variables Reference
# ==============================================================================
# This file provides a consolidated reference for configuring both Frontend (Vercel)
# and Backend (Railway) production environments.
# NEVER commit actual secrets, credentials, or production tokens to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------

# [CORE] Canonical Production Domain
# Set to your custom domain once DNS is mapped (e.g., https://omnitools.dev).
# If unset, Vercel automatically falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://omnitools.dev

# [API] Backend API base URL
# Live Railway deployment:
NEXT_PUBLIC_API_URL=https://web-production-19b17d.up.railway.app

# [ADS] Google AdSense Configuration (Safe default: disabled)
# Set to 'true' after receiving official Google AdSense site approval.
NEXT_PUBLIC_ADS_ENABLED=false
# Formats accepted: pub-XXXXXXXXXXXXXXXX or ca-pub-XXXXXXXXXXXXXXXX (16 digits)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
# Show visual dashed placement boxes in development mode only (false in production)
NEXT_PUBLIC_ADS_DEV_PLACEHOLDERS=false

# [ANALYTICS] Privacy-Safe Aggregate Analytics (Safe default: disabled)
# Set to 'true' to enable non-invasive, privacy-preserving page metrics.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Supported providers: 'gtag' (Google Analytics 4), 'plausible', 'fathom', or 'none'
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
# Measurement ID: G-XXXXXXXXXX for GA4, yourdomain.com for Plausible
NEXT_PUBLIC_ANALYTICS_ID=

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configure in Railway Project Settings)
# ------------------------------------------------------------------------------

# [SERVER] Network & Runtime
# Note: Railway automatically injects PORT and HOST in production.
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# [DATABASE] PostgreSQL Connection
# On Railway, adding the PostgreSQL plugin automatically provisions DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnitools?schema=public"

# [SECURITY & CORS] Permitted Client Origins
# Comma-separated list of allowed origins. *.vercel.app is allowed by default.
CORS_ORIGIN="http://localhost:3000,https://omnitools.dev,https://*.vercel.app"
RATE_LIMIT_MAX=100
