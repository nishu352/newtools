# Server Configuration (Railway automatically sets PORT)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# ─── Railway Production URL ────────────────────────────────────────────────────
# Backend is live at: https://web-production-19b17d.up.railway.app
#   Health: https://web-production-19b17d.up.railway.app/health
#   API:    https://web-production-19b17d.up.railway.app/api/v1/meta/platform
# ───────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL)
# On Railway: Add a PostgreSQL plugin to your project.
# Railway automatically injects DATABASE_URL — do NOT set this manually there.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnitools?schema=public"

# Security & CORS
# Comma-separated allowed frontend origins, or * for open access.
# All *.vercel.app domains are automatically permitted by default.
CORS_ORIGIN="http://localhost:3000,https://*.vercel.app"
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
