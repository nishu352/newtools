# Server Configuration (Railway automatically sets PORT)
PORT=4000
HOST=0.0.0.0
NODE_ENV=production

# Database (PostgreSQL)
# On Railway: Add a PostgreSQL plugin to your project; Railway automatically injects DATABASE_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/omnitools?schema=public"

# Security & CORS
# Comma-separated allowed frontend origins (e.g., https://your-site.vercel.app) or * for open access.
# Note: Any *.vercel.app domain is automatically permitted by default.
CORS_ORIGIN="http://localhost:3000,https://*.vercel.app"
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=info
